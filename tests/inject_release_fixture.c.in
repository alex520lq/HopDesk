#include "hop.h"
#include <assert.h>
#include <stdlib.h>
#include <stdio.h>
#include <string.h>
typedef unsigned CGKeyCode;
typedef unsigned long long CGEventFlags;
typedef int CGMouseButton;
typedef int CGEventType;
typedef struct { double x,y; } CGPoint;
static CGPoint CGPointMake(double x,double y){CGPoint p={x,y};return p;}
enum {kCGEventFlagMaskShift=1,kCGEventFlagMaskControl=2,kCGEventFlagMaskAlternate=4,
 kCGEventFlagMaskCommand=8,kCGEventFlagMaskAlphaShift=16,kCGEventFlagsChanged=100,
 kCGEventLeftMouseDown=10,kCGEventLeftMouseUp=11,kCGEventRightMouseDown=12,kCGEventRightMouseUp=13,
 kCGEventOtherMouseDown=14,kCGEventOtherMouseUp=15,kCGMouseButtonLeft=0,kCGMouseButtonRight=1,
 kCGMouseButtonCenter=2,kCGHIDEventTap=0};
typedef struct {int type,down;unsigned code;CGEventFlags flags;CGMouseButton button;} Event;
typedef Event *CGEventRef;
static int keyups,mouseups,enters;static Event last_event;
static struct {int sharing,btn_held[3];double mouse_x,mouse_y;} s_input;
static uint8_t s_held_keys[65536/8],s_paste_suppressed[65536/8],s_modn[4];
static int clipboard_request_remote_paste(void){return 0;}
static int s_caps,s_inited=1;static double s_over,s_h=1080;static CGEventFlags s_flags;
static void inject_init(void){s_inited=1;}
static void inject_enter(int y){(void)y;enters++;s_input.sharing=1;}
static CGEventRef CGEventCreateKeyboardEvent(void *src,CGKeyCode kc,int down){
 (void)src;Event *e=calloc(1,sizeof(*e));assert(e);e->code=kc;e->down=down;return e;
}
static CGEventRef CGEventCreateMouseEvent(void *src,CGEventType type,CGPoint pt,CGMouseButton button){
 (void)src;(void)pt;Event *e=calloc(1,sizeof(*e));assert(e);e->type=type;e->button=button;return e;
}
static void CGEventSetType(CGEventRef e,int t){assert(e);e->type=t;}
static void CGEventSetFlags(CGEventRef e,CGEventFlags f){assert(e);e->flags=f;}
static void CGEventPost(int tap,CGEventRef e){
 (void)tap;assert(e);last_event=*e;
 if(e->type==0 && !e->down)keyups++;
 if(e->type==kCGEventLeftMouseUp || e->type==kCGEventRightMouseUp || e->type==kCGEventOtherMouseUp)mouseups++;
}
static void CFRelease(CGEventRef e){free(e);}
/* Mirrors the production mouse-event modifier policy for the isolated fixture. */
static void post_mouse(CGEventRef e){
 if(!e)return;
 CGEventSetFlags(e,s_flags & ~kCGEventFlagMaskControl);
 CGEventPost(kCGHIDEventTap,e);
 CFRelease(e);
}
@FUNCTIONS@
int main(void){
 inject_key(0,1);inject_key(7,1);
 inject_key(0x37,1);inject_key(0x37,1);assert(s_modn[3]==1); /* repeat != two held modifiers */
 s_input.sharing=1;
 s_modn[1]=1;recompute_flags();
 inject_button(HOP_BTN_LEFT,1);
 assert(last_event.type==kCGEventLeftMouseDown && last_event.button==kCGMouseButtonLeft);
 assert((last_event.flags&kCGEventFlagMaskControl)==0);
 inject_button(HOP_BTN_LEFT,0);
 assert(last_event.type==kCGEventLeftMouseUp && last_event.button==kCGMouseButtonLeft);
 assert((last_event.flags&kCGEventFlagMaskControl)==0);
 s_modn[1]=0;recompute_flags();mouseups=0;
 inject_button(HOP_BTN_LEFT,1);inject_button(HOP_BTN_RIGHT,1);
 inject_reset();assert(keyups==2 && mouseups==2 && !s_modn[3] && !s_input.sharing);
 for(unsigned i=0;i<sizeof(s_held_keys);++i)assert(!s_held_keys[i]);
 inject_reset();assert(keyups==2 && mouseups==2); /* idempotent */
 inject_button(HOP_BTN_LEFT,0);assert(!s_input.sharing && !enters); /* late UP cannot re-enter */
 inject_button(HOP_BTN_LEFT,1);assert(s_input.sharing && enters==1);
 inject_release_all();assert(!s_input.btn_held[HOP_BTN_LEFT]);
 puts("PASS: production macOS releases normal keys, modifiers and mouse buttons without re-entry");return 0;
}
