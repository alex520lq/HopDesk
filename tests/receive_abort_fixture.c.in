static int try_image_buffer_ensure(hop_xfer_rx_image_buffer *buffer,uint64_t expected){
    return fail_alloc?0:hop_xfer_rx_image_buffer_ensure(buffer,expected);
}
#define hop_xfer_rx_image_buffer_ensure try_image_buffer_ensure
static void dispatch(uint8_t type,const uint8_t*p,uint32_t len){switch(type){
@RECEIVE_CASES@
default:break;
}}
#undef hop_xfer_rx_image_buffer_ensure
static void image_begin(uint32_t batch,uint32_t width){
    uint8_t p[20];hop_put_be32(p,batch);hop_put_be32(p+4,1);hop_put_be32(p+8,width);
    hop_put_be32(p+12,2);hop_put_be32(p+16,4);dispatch(HOP_MSG_IMAGE_BEGIN,p,sizeof(p));
}
static void chunk(uint32_t id,uint64_t off,int bad_crc){
    uint8_t p[24]={0};hop_put_be32(p,id);hop_put_be64(p+4,off);hop_put_be32(p+12,4);
    hop_put_be32(p+16,hop_crc32(0,p+20,4)^(bad_crc?1u:0u));dispatch(HOP_MSG_FILE_CHUNK,p,sizeof(p));
}
static void peer_abort_target(uint32_t batch,uint8_t reason,uint8_t target){uint8_t p[6];hop_put_be32(p,batch);p[4]=reason;p[5]=target;dispatch(HOP_MSG_XFER_ABORT,p,6);}
static void peer_abort(uint32_t batch,uint8_t reason){peer_abort_target(batch,reason,HOP_ABORT_TO_RECEIVER);}
static void late_done(uint32_t batch){uint8_t p[20]={0};hop_put_be32(p,batch);hop_put_be32(p+4,1);hop_put_be32(p+8,1);dispatch(HOP_MSG_XFER_DONE,p,20);}
static void late_end(void){uint8_t p[9]={0};hop_put_be32(p,1);dispatch(HOP_MSG_FILE_END,p,9);}
static void seed_resources(void){
    s_rx.cur_path=malloc(8*sizeof(*s_rx.cur_path));assert(s_rx.cur_path);s_rx.cur_path[0]=0;
    s_rx.tops=malloc(sizeof(*s_rx.tops));assert(s_rx.tops);
    s_rx.tops[0]=malloc(8*sizeof(**s_rx.tops));assert(s_rx.tops[0]);s_rx.tops[0][0]=0;s_rx.ntop=1;
    closed=0;
}
static void assert_terminal(uint32_t batch,uint8_t reason,int before){
    uint8_t tombstone_reason=0;
    assert(!s_rx.active && !s_rx.batch &&
           hop_xfer_rx_lifecycle_dead_reason(&s_rx_lifecycle,batch,&tombstone_reason) &&
           tombstone_reason==reason);
    assert(!s_rx.cur_path && !s_rx.image_buffer.data && !s_rx.tops && !s_rx.ntop && !s_rx.image_buffer.capacity && !s_rx.image_state.expected && !s_rx.image_state.received);
    assert(!s_rx.file_state.is_image && !s_rx.file_state.id && !s_rx.file_state.declared_size && !s_rx.dir[0]);
    assert(!s_rx.task.initialized);
    hop_xfer_budget_snapshot budget_snapshot;
    hop_xfer_budget_get_snapshot(&budget_snapshot);
    assert(budget_snapshot.jobs==0 && budget_snapshot.entries==0 &&
           budget_snapshot.pending_bytes==0 && budget_snapshot.image_bytes==0);
    assert(xfer_busy() && !s_receive_status.status.active && closed); /* outgoing state still owns admission */
    assert(saved==before+1 && s_history[0].batch==batch);
    assert(s_history[0].phase==(reason==HOP_ABORT_CANCEL?HOP_XFER_CANCELLED:HOP_XFER_FAILED));
    assert(s_send_status.status.active); /* receiving ABORT cannot end outgoing state */
}
int main(void){
    hop_xfer_rx_lifecycle_init(&s_rx_lifecycle);
    hop_session_id initial_session={{1}};
    (void)hop_xfer_rx_lifecycle_bind_session(&s_rx_lifecycle,&initial_session);
    hop_xfer_tracking_begin(&s_send_status,999,HOP_XFER_DIR_SEND,1,0,"out",HOP_XFER_SENDING);
    for(int scenario=0;scenario<9;scenario++){
        uint32_t batch=100u+(uint32_t)scenario*2u;int before=saved;
        image_begin(batch,1);assert(xfer_busy());seed_resources();
        int old_closes=closes,old_discarded=discarded;
        /* Allocate an actual partial image before CRC, overlap and bounds failures. */
        if(scenario==1 || scenario==3 || scenario==4){
            chunk(1,0,0);
            assert(s_rx.image_buffer.data && s_rx.image_buffer.capacity==s_rx.image_state.expected);
        }
        uint8_t reason=HOP_ABORT_TOO_LARGE;fail_send=1; /* failed wire send must still clean up */
        switch(scenario){
            case 0:image_begin(batch,0);break;
            case 1:reason=HOP_ABORT_CRC;chunk(1,4,1);break;
            case 2:chunk(1,4,0);break; /* gap */
            case 3:chunk(1,0,0);break; /* overlap */
            case 4:chunk(1,8,0);break; /* rejected by early bounds validator */
            case 5:dispatch(HOP_MSG_FILE_CHUNK,NULL,0);break;
            case 6:reason=HOP_ABORT_CRC;chunk(2,0,0);break;
            case 7:reason=HOP_ABORT_DISK;fail_alloc=1;chunk(1,0,0);fail_alloc=0;break;
            case 8:dispatch(HOP_MSG_IMAGE_BEGIN,NULL,0);break;
        }
        fail_send=0;assert_terminal(batch,reason,before);
        assert(closes==old_closes+1 && discarded==old_discarded+1 && last_reason==reason);
        int notices=notified;
        image_begin(batch,1);assert(notified==notices+1 && last_reason==reason);
        chunk(1,0,0);late_end();late_done(batch);peer_abort(batch,reason);rx_cancel_local();
        assert_terminal(batch,reason,before);assert(closes==old_closes+1);
        image_begin(batch+1,1);seed_resources();
        s_x.cancel_rx=1;
        image_begin(batch,1); /* tombstone survives a newer active receive */
        assert(s_x.cancel_rx==1); /* stale BEGIN must not consume the newer cancellation */
        assert(s_rx.active && s_rx.batch==batch+1 && s_rx.cur_path && saved==before+1);
        peer_abort(batch,reason);late_done(batch);assert(s_rx.active && s_rx.batch==batch+1);
        rx_cancel_local();assert_terminal(batch+1,HOP_ABORT_CANCEL,before+1);
        peer_abort(batch+1,HOP_ABORT_CANCEL);rx_cancel_local();assert(saved==before+2);
    }
    /* Setup errors now start and terminate a tracked batch, including its tombstone. */
    int before=saved;fail_directory=1;image_begin(200,1);fail_directory=0;
    assert_terminal(200,HOP_ABORT_DISK,before);
    /* Peer-triggered cleanup must not echo another ABORT or duplicate history. */
    before=saved;image_begin(201,1);seed_resources();int notices=notified;
    /* Both directions use batch 201: a sender-target ABORT must not touch RX. */
    s_x.cur_batch=201; s_x.abort_batch=0;
    peer_abort_target(201,HOP_ABORT_CANCEL,HOP_ABORT_TO_SENDER);
    assert(s_x.abort_batch==201 && s_x.abort_reason==HOP_ABORT_CANCEL && s_rx.active && s_rx.batch==201 && saved==before);
    s_x.abort_batch=0;
    peer_abort(201,HOP_ABORT_CRC);
    assert(s_x.abort_batch==0);assert_terminal(201,HOP_ABORT_CRC,before);assert(notified==notices);
    peer_abort(201,HOP_ABORT_CRC);assert(saved==before+1);
    /* An accepted per-ID cancellation wins against a concurrent DONE. */
    before=saved; image_begin(202,1); seed_resources();
    assert(hop_xfer_task_request_cancel(s_rx.task.id));
    late_done(202); assert_terminal(202,HOP_ABORT_CANCEL,before);
    assert(applied==0);
    /* A same-session data outage is bounded; reconnect resets the grace timer. */
    before=saved; image_begin(203,1); seed_resources();s_x.cancel_rx=0;s_x.peer_ready=0;
    rx_poll_cancel();fake_ms+=HOP_XFER_RX_DISCONNECT_BUDGET_MS-3;rx_poll_cancel();assert(s_rx.active);
    s_x.peer_ready=1;rx_poll_cancel();s_x.peer_ready=0;rx_poll_cancel();assert(s_rx.active);
    fake_ms+=HOP_XFER_RX_DISCONNECT_BUDGET_MS;rx_poll_cancel();
    assert_terminal(203,HOP_ABORT_TIMEOUT,before);
    assert(!s_rx.task.initialized); /* reservation returned on timeout */
    /* Cancellation accepted before a control-session replacement must win. */
    before=saved;image_begin(204,1);seed_resources();assert(hop_xfer_task_request_cancel(s_rx.task.id));
    notices=notified; /* the socket may already be bound to the next session */
    hop_session_id next_session={{2}};rx_bind_session(&next_session);
    assert(!s_rx.active && !s_rx.task.initialized && saved==before+1);
    assert(s_history[0].batch==204 && s_history[0].phase==HOP_XFER_CANCELLED);
    assert(notified==notices); /* never send old-session ABORT to a new peer */
    assert(s_send_status.status.active); /* replacement cannot cancel the other direction */
    /* A FILE_ACK may not impersonate the dedicated completion slot. */
    uint8_t fake_ack[9]={0};hop_put_be32(fake_ack,205);hop_put_be32(fake_ack+4,HOP_DONE_ACK_SLOT);
    dispatch(HOP_MSG_FILE_ACK,fake_ack,9);assert(ack_deliveries==0);
    hop_put_be32(fake_ack+4,1);dispatch(HOP_MSG_FILE_ACK,fake_ack,9);assert(ack_deliveries==1 && ack_id==1);
    uint8_t done_ack[5]={0};hop_put_be32(done_ack,205);done_ack[4]=HOP_DONE_ACK_FAILED+1;
    dispatch(HOP_MSG_XFER_DONE_ACK,done_ack,5);assert(ack_deliveries==1);
    done_ack[4]=HOP_DONE_ACK_COMPLETE;dispatch(HOP_MSG_XFER_DONE_ACK,done_ack,5);
    assert(ack_deliveries==2 && ack_id==HOP_DONE_ACK_SLOT);
    /* Lost ACK can be retried without re-applying the image or duplicating history. */
    int old_applied=applied, old_acks=done_acks;before=saved;
    image_begin(205,1);chunk(1,0,0);chunk(1,4,0);assert(s_rx.image_state.received==s_rx.image_state.expected);
    late_done(205);assert(!s_rx.active && applied==old_applied+1 && saved==before+1);
    assert(done_acks==old_acks+1 && last_done_status==HOP_DONE_ACK_COMPLETE);
    late_done(205);assert(applied==old_applied+1 && saved==before+1 && done_acks==old_acks+2);
    uint8_t altered[20]={0};hop_put_be32(altered,205);hop_put_be32(altered+8,1);
    dispatch(HOP_MSG_XFER_DONE,altered,20);assert(done_acks==old_acks+2);
    image_begin(205,1);assert(!s_rx.active); /* no reuse within same session */
    hop_session_id new_session={{3}};rx_bind_session(&new_session);
    late_done(205);assert(done_acks==old_acks+2); /* old receipt never crosses session */
    s_x.cur_batch=0; s_send_status.status.active=0;assert(!xfer_busy()); /* sender retry window is no longer active */
    puts("PASS: production receive ABORT lifecycle, early bounds errors, busy reset, tombstones and once-only history");
    return 0;
}
