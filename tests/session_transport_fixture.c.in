#include "hop.h"
#include "update_state.h"
#include "xfer_rate.h"
#include <assert.h>
#include <string.h>
#include <stdlib.h>
#include <stdio.h>
#include <limits.h>
#include "xfer_tracking.h"
#include "xfer_task.h"
#include "xfer_sender_context.h"
#include "xfer_sender_context_adapter.h"
#include "xfer_sender_chunk.h"
#include "xfer_rx_receipt.h"
#include "xfer_rx_lifecycle.h"
#include "xfer_rx_services.h"
#include "xfer_rx_context.h"
#include "xfer_rx_batch_state.h"
#define SD_BOTH 2
#define SHUT_RDWR 2
#define INVALID_SOCKET -1
typedef int SOCKET;
static struct {int client,sock,lock,slock;unsigned long epoch;uint32_t chunk;hop_session_id session;hop_xfer_rate_limiter rate;} s_x;
typedef struct {
    int *state_lock;
    int *session_lock;
    int *tx_lock;
    int *queue_lock;
    int *client;
    int *sock;
    hop_session_id *session;
    unsigned long *epoch;
} sender_platform_context;
static sender_platform_context s_sender_platform;
static hop_xfer_sender_context s_sender_context;
static xfer_rx_context s_rx;
static hop_xfer_rx_done_receipt s_done_receipt;
static hop_xfer_rx_lifecycle s_rx_lifecycle;
static struct {int marker;} s_send_status,s_receive_status;
static int s_status_lock,resets,closes,discarded,paste_cancelled;
void hop_xfer_rx_reset_batch_state(void *context);
static void fixture_close_file(void *context){(void)context;closes++;}
static int fixture_discard_dir(void *context){(void)context;assert(closes>0);discarded++;return 1;}
static int test_begin_completion(const hop_xfer_task *t){(void)t;return 1;}
static int test_cancel_requested(hop_xfer_task_id t){(void)t;return 0;}
#define hop_xfer_task_begin_completion test_begin_completion
#define hop_xfer_task_cancel_requested test_cancel_requested
static void finish_paste(uint32_t b,const void*p,int n,int ok){(void)b;(void)p;(void)n;assert(!ok);paste_cancelled++;}
static void fixture_cancel_clipboard(void *context,uint32_t batch){(void)context;finish_paste(batch,NULL,0,0);}
static void fixture_status_reset(void *context){(void)context;s_receive_status.marker=0;resets++;}
#define clip_complete_remote_paste finish_paste
#define clipboard_complete_remote_paste finish_paste
typedef struct {
    hop_session_id session;
    int next_i,ok;
    hop_xfer_sender_context sender_context;
    hop_xfer_task task;
} xf_job;
typedef xf_job xfer_job;
#define AcquireSRWLockExclusive(p) ((void)(p))
#define ReleaseSRWLockExclusive(p) ((void)(p))
static uint8_t captured[512];static size_t captured_len;static int delivered,closed;
#define EnterCriticalSection(p) ((void)(p))
#define LeaveCriticalSection(p) ((void)(p))
#define pthread_mutex_lock(p) ((void)(p))
#define pthread_mutex_unlock(p) ((void)(p))
static int s_txlock;
static unsigned long s_send_epoch;
static uint64_t rate_now_ns(void){return 0;}
static uint64_t fixture_context_now_ns(void *user){(void)user;return rate_now_ns();}
static int fixture_context_wait_ns(void *user,uint64_t ns){(void)user;(void)ns;return 1;}
static int fixture_context_is_stopping(void *user){(void)user;return 0;}
typedef struct {int stopping;uint64_t waited_ns;} fixture_sender_wait;
static int fixture_sender_is_stopping(void *user){
    return ((fixture_sender_wait *)user)->stopping;
}
static int fixture_sender_wait_ns(void *user,uint64_t duration_ns){
    fixture_sender_wait *state=(fixture_sender_wait *)user;
    state->waited_ns+=duration_ns;
    return !state->stopping;
}
static void rate_feedback(uint64_t ack_rtt_us){(void)ack_rtt_us;}
static int send_all(int fd,const void *p,size_t n){assert(fd==7);assert(captured_len+n<=sizeof(captured));memcpy(captured+captured_len,p,n);captured_len+=n;return 1;}
static int shutdown(int fd,int how){(void)fd;(void)how;closed++;return 0;}
static void xfer_kick(void){closed++;}
static void on_data_msg(void *user,uint8_t type,const uint8_t *p,uint32_t len){(void)user;(void)type;(void)p;(void)len;delivered++;}
#define CHUNK_HDR (25u + HOP_DATA_PREFIX)
static int not_busy(void){return 0;}
@FUNCTIONS@
int main(void){
 s_rx.lifecycle=&s_rx_lifecycle;s_rx.done_receipt=&s_done_receipt;s_rx.services.context=&s_rx;
 s_rx.services.close_file=fixture_close_file;s_rx.services.discard_staging_directory=fixture_discard_dir;
s_rx.services.cancel_clipboard=fixture_cancel_clipboard;s_rx.services.status_reset=fixture_status_reset;
 s_x.session.bytes[0]=1;s_x.client=s_x.sock=7;s_x.epoch=3;s_x.chunk=2;
  hop_xfer_rate_init(&s_x.rate,1000,1000,1000,2,0);hop_session_publish(&s_x.session);
 s_sender_platform.state_lock=&s_x.lock;s_sender_platform.session_lock=&s_x.slock;
 s_sender_platform.tx_lock=&s_txlock;s_sender_platform.queue_lock=&s_x.lock;
 s_sender_platform.client=&s_x.client;s_sender_platform.sock=&s_x.sock;
 s_sender_platform.session=&s_x.session;s_sender_platform.epoch=&s_x.epoch;
 s_sender_context.user=&s_sender_platform;
 s_sender_context.session_current=sender_context_session_current;
 s_sender_context.snapshot_session=sender_context_snapshot_session;
  s_sender_context.now_ns=fixture_context_now_ns;s_sender_context.wait_ns=fixture_context_wait_ns;
  s_sender_context.is_stopping=fixture_context_is_stopping;
  s_sender_context.write_frame=sender_context_write_frame;
 hop_xfer_rx_lifecycle_mark_dead(&s_rx_lifecycle,42,HOP_ABORT_CANCEL);s_receive_status.marker=9;rx_bind_session(&s_x.session);
 assert(resets==1 && !hop_xfer_rx_lifecycle_dead_reason(&s_rx_lifecycle,42,NULL) && !s_receive_status.marker);
 assert(hop_xfer_rx_batch_state_begin(&s_rx.batch_state,HOP_XFER_PASTE_BATCH_FLAG|42));hop_xfer_rx_lifecycle_mark_dead(&s_rx_lifecycle,42,HOP_ABORT_DISK);rx_bind_session(&s_x.session);
 assert(resets==1 && closes==1 && !discarded && !paste_cancelled && hop_xfer_rx_lifecycle_dead_reason(&s_rx_lifecycle,42,NULL));
 hop_session_id next={{2}};rx_bind_session(&next);assert(resets==2 && !hop_xfer_rx_lifecycle_dead_reason(&s_rx_lifecycle,42,NULL) && discarded==1 && paste_cancelled==1);
 rx_bind_session(&s_x.session);assert(hop_xfer_rx_batch_state_begin(&s_rx.batch_state,42));
 rx_expire_stale_session();assert(s_rx.batch_state.active && discarded==1);
 hop_session_clear(&s_x.session);rx_expire_stale_session();
 assert(!s_rx.batch_state.active && discarded==2 && paste_cancelled==1);
 rx_expire_stale_session();assert(discarded==2);
 hop_session_publish(&s_x.session);rx_bind_session(&s_x.session);assert(hop_xfer_rx_batch_state_begin(&s_rx.batch_state,42));
 xf_job job={0};job.session=next;job.next_i=3;job.ok=3;s_send_status.marker=9;
 fixture_sender_wait wait_state={0};
 job.sender_context.user=&wait_state;
 job.sender_context.is_stopping=fixture_sender_is_stopping;
 job.sender_context.wait_ns=fixture_sender_wait_ns;
 assert(!sender_commit_is_stopping(&job));
 assert(sender_commit_wait_ms(&job,17));
 assert(wait_state.waited_ns==17000000ull);
 wait_state.stopping=1;
 assert(sender_commit_is_stopping(&job));
 assert(!sender_commit_wait_ms(&job,1));
 wait_state.stopping=0;
 /* Session rebinding and checkpoint reset are covered by the shared Worker tests. */
 uint8_t end[9]={0};hop_put_be32(end,3);
 assert(send_small(7,HOP_MSG_FILE_END,end,sizeof(end),42));
 assert(captured_len==HOP_HEADER_SIZE+HOP_DATA_PREFIX+sizeof(end));
 assert(hop_get_be32(captured+1)==HOP_DATA_PREFIX+sizeof(end));
 const uint8_t *body;uint32_t batch,n;
 assert(hop_data_unwrap(HOP_MSG_FILE_END,captured+HOP_HEADER_SIZE,(uint32_t)captured_len-HOP_HEADER_SIZE,&s_x.session,&batch,&body,&n));
 assert(batch==42 && n==sizeof(end) && !memcmp(body,end,n));
 assert(hop_xfer_rx_batch_state_end(&s_rx.batch_state,42));assert(hop_xfer_rx_batch_state_begin(&s_rx.batch_state,43));
 on_data_frame(NULL,HOP_MSG_FILE_END,captured+HOP_HEADER_SIZE,(uint32_t)captured_len-HOP_HEADER_SIZE);
 assert(delivered==0 && !closed); /* old END cannot finalize the new batch */
 assert(hop_xfer_rx_batch_state_end(&s_rx.batch_state,43));assert(hop_xfer_rx_batch_state_begin(&s_rx.batch_state,42));on_data_frame(NULL,HOP_MSG_FILE_END,captured+HOP_HEADER_SIZE,(uint32_t)captured_len-HOP_HEADER_SIZE);
 assert(delivered==1 && !closed);
 captured_len=0;uint8_t tx[CHUNK_HDR+2],pixels[2]={4,5};
 assert(send_chunk(&s_sender_context,7,tx,42,3,9,pixels,2,123,0,0));
 assert(captured_len==CHUNK_HDR+2 && hop_get_be32(captured+1)==40+2);
 assert(hop_data_unwrap(HOP_MSG_FILE_CHUNK,captured+5,(uint32_t)captured_len-5,&s_x.session,&batch,&body,&n));
 assert(batch==42 && n==22 && hop_get_be32(body)==3 && hop_get_be64(body+4)==9 && !memcmp(body+20,pixels,2));
 assert(hop_xfer_rx_batch_state_end(&s_rx.batch_state,42));assert(hop_xfer_rx_batch_state_begin(&s_rx.batch_state,43));on_data_frame(NULL,HOP_MSG_FILE_CHUNK,captured+5,(uint32_t)captured_len-5);assert(delivered==1);
 captured[5]^=2;on_data_frame(NULL,HOP_MSG_FILE_CHUNK,captured+5,(uint32_t)captured_len-5);assert(closed==1 && delivered==1);
 captured[5]^=2;hop_session_clear(&s_x.session);
 on_data_frame(NULL,HOP_MSG_FILE_CHUNK,captured+5,(uint32_t)captured_len-5);assert(closed==2);
 captured_len=0;assert(!send_small(7,HOP_MSG_FILE_END,end,9,42) && !captured_len);
 assert(hop_update_install_begin(not_busy));
 int old_delivered=delivered,old_closed=closed;
 on_data_frame(NULL,HOP_MSG_FILE_BEGIN,end,9);
 assert(delivered==old_delivered && closed==old_closed+1);
 hop_update_install_end();
 puts("PASS: production session cleanup and sender/receiver rejects foreign sessions and late batch CHUNK/END");return 0;
}
