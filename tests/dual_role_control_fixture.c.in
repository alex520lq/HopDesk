/* Production macOS dispatch with platform effects doubled. Scheduling itself is
 * not tested here; main-queue blocks are made synchronous by the extractor. */
#include "hop.h"
#include <assert.h>
#include <stdlib.h>
#include <string.h>
#include <stdio.h>
void hop_log(hop_log_level level,const char *fmt,...){(void)level;(void)fmt;}
static struct {hop_config cfg;double screen_w,screen_h;} g_mac;
static int s_authed,s_rejected,connected,injected,returned,clip_applied,inject_resets,status_sharing;
static uint64_t s_last_rx;
static hop_session_id s_control_session;
static uint8_t sent_type,sent[256];static uint32_t sent_len;
static void mac_capture_peer_geometry(uint32_t w,uint32_t h){assert(w==1920&&h==1080);}
static void mac_capture_return(void){returned++;}
static int net_send(uint8_t t,const void *p,uint32_t n){sent_type=t;sent_len=n;if(n)memcpy(sent,p,n);return 1;}
static void set_connected(int on){connected=on;}
static void inject_set_peer_geometry(uint32_t w,uint32_t h){(void)w;(void)h;}
static void inject_enter(int n){(void)n;injected++;}
static void inject_move(int x,int y){(void)x;(void)y;injected++;}
static void inject_button(int b,int d){(void)b;(void)d;injected++;}
static void inject_wheel(int x,int y){(void)x;(void)y;injected++;}
static void inject_key(uint16_t k,int d){(void)k;(void)d;injected++;}
static void inject_reset(void){inject_resets++;}
static void statusbar_update(int on,int sharing){(void)on;status_sharing=sharing;}
static void clipboard_apply(const char *s){assert(!strcmp(s,"hello"));clip_applied++;}
static void disp_wake(int s){(void)s;}
static void disp_set_input(uint16_t n){(void)n;}
static void disp_sleep(void){}
@DISPATCH@
static void reset(void){
    hop_session_id old;if(hop_session_current(&old))hop_session_clear(&old);
    memset(&g_mac,0,sizeof(g_mac));g_mac.cfg.role=HOP_ROLE_SERVER;
    strcpy(g_mac.cfg.token,"secret");strcpy(g_mac.cfg.device_name,"Mac-server");
    g_mac.screen_w=1440;g_mac.screen_h=900;s_authed=s_rejected=connected=injected=returned=clip_applied=inject_resets=status_sharing=0;
    sent_type=0;sent_len=0;
}
int main(void){
    uint8_t hello[32]={6,'s','e','c','r','e','t',1,'W'};
    hop_put_be32(hello+9,1920);hop_put_be32(hello+13,1080);hello[17]=HOP_CTRL_PROTO_VER;
    reset();hello[1]='X';dispatch_message(NULL,HOP_MSG_HELLO,hello,18);
    assert(s_rejected&&!connected&&!sent_type);
    reset();hello[1]='s';hello[17]=HOP_CTRL_PROTO_VER-1;dispatch_message(NULL,HOP_MSG_HELLO,hello,18);
    assert(s_rejected&&!connected);
    reset();hello[17]=HOP_CTRL_PROTO_VER;dispatch_message(NULL,HOP_MSG_HELLO,hello,18);
    assert(s_authed&&connected&&!s_rejected&&sent_type==HOP_MSG_HELLO_ACK);
    int ok;uint32_t w,h;hop_session_id session;
    assert(hop_hello_ack_decode(sent,sent_len,&ok,&w,&h,&session)&&ok&&w==1440&&h==900);
    assert(hop_session_matches(&session));
    uint8_t payload[9]={0};dispatch_message(NULL,HOP_MSG_MOUSE_ENTER,payload,2);
    dispatch_message(NULL,HOP_MSG_KEY_DOWN,payload,2);assert(!injected);
    dispatch_message(NULL,HOP_MSG_EDGE_LEAVE,payload,1);assert(returned==1);
    hop_put_be32(payload,HOP_DEV_CLIENT);memcpy(payload+4,"hello",5);
    dispatch_message(NULL,HOP_MSG_CLIP_TEXT,payload,9);assert(clip_applied==1);
    hop_put_be32(payload,HOP_DEV_SERVER);dispatch_message(NULL,HOP_MSG_CLIP_TEXT,payload,9);assert(clip_applied==1);
    reset();g_mac.cfg.role=HOP_ROLE_CLIENT;s_authed=1;status_sharing=1;
    dispatch_message(NULL,HOP_MSG_EDGE_LEAVE,NULL,0);
    assert(inject_resets==1 && status_sharing==0);
    reset();puts("PASS: production macOS dispatch authentication, role gating, clipboard origin and server return");return 0;
}
