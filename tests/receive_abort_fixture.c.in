static int send_small(int fd,uint8_t type,const uint8_t*p,uint32_t n,uint32_t batch){(void)batch;
    (void)fd;
    if(type==HOP_MSG_XFER_DONE_ACK){assert(n==5);done_acks++;last_done_status=p[4];return 1;}
    if(fail_send) { assert(!closed); }
    assert(type==HOP_MSG_XFER_ABORT && n==6 && p[5]==HOP_ABORT_TO_SENDER);last_reason=p[4];notified++;return !fail_send;
}
